{
  "name": "shift-system-v2",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --exclude 'tests/performance-*.test.js' && node --experimental-vm-modules --test tests/performance-client.test.js tests/performance-proxy.test.js",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "0.28.2",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.2",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
